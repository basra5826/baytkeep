{
  "expo": {
    "name": "Baytkeep",
    "slug": "home-inventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "baytkeep",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Baytkeep uses the camera so you can photograph your belongings and warranty papers.",
        "NSPhotoLibraryUsageDescription": "Baytkeep accesses your photo library so you can attach photos of your belongings and warranty papers.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.edbasra.homeinventory"
    },
    "android": {
      "package": "com.edbasra.homeinventory",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F5EFE7"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EFE7",
          "image": "./assets/images/icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Baytkeep accesses your photo library so you can attach photos of your belongings and warranty papers.",
          "cameraPermission": "Baytkeep uses the camera so you can photograph your belongings and warranty papers."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C4694A",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97b705ab-5d5d-441d-9c97-5c25683194fd"
      }
    }
  }
}
